NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Email (Resend). Tickets, guest passes, workflow emails, and sign-in links.
RESEND_API_KEY=
RESEND_FROM="The ARK <tickets@theark.world>"
NEXT_PUBLIC_SITE_URL=
# Show "Sign in with Google" on the team page once the provider is set up in Supabase
NEXT_PUBLIC_GOOGLE_SIGNIN=

# Apple Wallet (needs an Apple Developer account). PEM files, base64-encoded.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=

# Server only. With RESEND_API_KEY, lets the app send sign-in emails itself in
# the ARK template (with a 6-digit code) instead of Supabase's mailer. Also
# powers the GoHighLevel webhook (/api/webhooks/ghl), the daily GHL sync
# (/api/cron/integrations) and the push to GHL after each CRM save. The GHL
# token itself is entered in Settings → Integrations, not here.
SUPABASE_SERVICE_ROLE_KEY=

# AI drafting in workflows (Claude). Leave empty to keep AI off.
ANTHROPIC_API_KEY=

# Marketing email. Sender for campaigns and the waitlist automation (falls back
# to RESEND_FROM). CRON_SECRET guards /api/cron/marketing (Vercel sends it).
# RESEND_WEBHOOK_SECRET is the signing secret of the Resend webhook pointed at
# /api/webhooks/resend, for opens, clicks and bounces.
MARKETING_FROM="The ARK <hello@theark.world>"
CRON_SECRET=
RESEND_WEBHOOK_SECRET=

# Stripe (test keys until launch: sk_test_… and the webhook's whsec_…).
# Payments for day/week passes, membership terms and event tickets. Needs
# SUPABASE_SERVICE_ROLE_KEY too, to record payments. Point a Stripe webhook at
# /api/webhooks/stripe (see Settings → Integrations → Stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
